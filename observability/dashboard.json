{
  "uid": "securerag-audit",
  "title": "secureRAG — audit stream",
  "tags": ["securerag"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Errors",
      "description": "app.error, model-unavailable, and connector-sync failures (decision=error) in range. Green = healthy; red on any error.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"securerag\", decision=\"error\"} [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Queries answered",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"securerag\", event=\"query.answered\"} [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Denied / blocked",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"securerag\", decision=\"deny\"} [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failed logins",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"securerag\", event=\"auth.login\", decision=\"deny\"} [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Mode",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (mode) (count_over_time({job=\"securerag\", event=\"query.answered\"} [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Documents uploaded",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 4 },
      "description": "Successful /upload calls. The only write path into retrieval an ordinary account can reach.",
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum (count_over_time({job=\"securerag\", event=\"ingest.upload\"} [$__range]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Uploads vs. refused write attempts",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 4 },
      "description": "Both series on one timeline on purpose: an upload burst next to a run of refusals is somebody hunting for an account that can write.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "refused write attempt" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "uploaded → {{tier}}",
          "expr": "sum by (tier) (count_over_time({job=\"securerag\", event=\"ingest.upload\"} [1m]))"
        },
        {
          "refId": "B",
          "legendFormat": "refused write attempt",
          "expr": "sum (count_over_time({job=\"securerag\", event=\"auth.role\", decision=\"deny\"} [1m]))"
        }
      ]
    },
    {
      "type": "table",
      "title": "Uploaded documents — who, what, where",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
      "description": "`source` is parsed from the line rather than promoted to a label — document names grow with the corpus and have no business in the Loki index. The parser names only the four fields that are not already labels; parsing the whole record collides with them and yields duplicate `*_extracted` columns.",
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{job=\"securerag\", event=\"ingest.upload\"} | json source=\"source\", chunks=\"chunks\", bytes=\"bytes\", replaced=\"replaced\""
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "Line": true,
              "id": true,
              "tsNs": true,
              "event": true,
              "decision": true,
              "origin": true,
              "job": true,
              "filename": true,
              "detected_level": true,
              "service_name": true,
              "ts": true
            },
            "indexByName": {
              "Time": 0,
              "actor": 1,
              "tier": 2,
              "source": 3,
              "chunks": 4,
              "bytes": 5,
              "replaced": 6
            },
            "renameByName": {
              "actor": "uploaded by",
              "source": "document",
              "replaced": "overwrote existing"
            }
          }
        },
        { "id": "sortBy", "options": { "sort": [{ "field": "Time", "desc": true }] } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events per minute by decision",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{decision}}",
          "expr": "sum by (decision) (count_over_time({job=\"securerag\"} [1m]))"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Live audit stream",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 27 },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true
      },
      "datasource": { "type": "loki", "uid": "securerag-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"securerag\"} |= `$search`"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "search",
        "type": "textbox",
        "label": "Filter",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "schemaVersion": 39,
  "version": 2
}
