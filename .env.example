# Copy to .env and fill in. Never commit .env.

# Phase switch. Defaults to false: the app runs deliberately exploitable so
# phase 2 can demonstrate working attacks. Phase 3 sets this to true and re-runs
# the same attack suite to show them failing. Insecure default on purpose —
# this is a lab artifact, not a pattern to copy.
SECURITY_FILTERS_ENABLED=false

# Auth — required. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SIGNING_KEY=
SESSION_TTL_SECONDS=3600

# Synthetic demo users, JSON on one line. No default user table ships with the
# app — absent DEMO_USERS means every login fails, which is the safe direction.
# DEMO_USERS='{"alice":{"password":"pw-alice","clearance":"restricted"},"carol":{"password":"pw-carol","clearance":"public"}}'
DEMO_USERS=

# Local model (Ollama). No API key: generation and embedding both run on this
# machine, so document text never leaves it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# Ollama defaults this to 2048, which silently truncates retrieved documents
# out of the prompt. Lower it only if you hit memory pressure.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=180

# Retrieval tuning
TOP_K=4
MAX_DISTANCE=0.75
CHUNK_CHARS=1000
CHUNK_OVERLAP=150

# App
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./audit.log

# Grafana admin password (observability stack)
GRAFANA_ADMIN_PASSWORD=
