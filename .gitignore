.env
.venv/
__pycache__/
*.py[cod]
audit.log
.pytest_cache/

# Generated at runtime. Contains embedded chunk text for every tier —
# treat as sensitive, never commit.
data/chroma_db/

# Uploaded through the API by the uploader role. Untrusted content, and it may
# carry any tier — never commit.
data/uploads/

# Uploads an approver rejected, moved here so ingest stops sweeping them. Same
# content as data/uploads/ and by definition the malicious end of it.
data/quarantine/

# observability runtime state
observability/data/


# Local tooling state (serena MCP index)
.serena/
