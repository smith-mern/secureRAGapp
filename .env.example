# Copy to .env and fill in. Never commit .env.

# Phase switch. Defaults to false: the app runs deliberately exploitable so
# phase 2 can demonstrate working attacks. Phase 3 sets this to true and re-runs
# the same attack suite to show them failing. Insecure default on purpose —
# this is a lab artifact, not a pattern to copy.
SECURITY_FILTERS_ENABLED=false

# Auth — required. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SIGNING_KEY=
SESSION_TTL_SECONDS=3600

# Synthetic demo users, JSON on one line. No default user table ships with the
# app — absent DEMO_USERS means every login fails, which is the safe direction.
#
# "clearance" is which tiers the account may touch (public < internal <
# restricted). "role" is what it may do, and is not a hierarchy:
#   reader   — /query and /chat. Cannot write to the index. The default.
#   uploader — /upload and /ingest. Cannot read anything back out.
#   approver — /review. Marks an uploaded or connector-sourced document as
#              reviewed, which is what lets it answer questions at all. Disjoint
#              from uploader so nobody approves their own writes.
# Exactly one demo account should hold each of uploader and approver. With no
# approver seeded, nothing uploaded can ever answer — the fail-closed direction,
# but it looks like the app has gone mute, so seed one.
#
# DEMO_USERS='{"alice":{"password":"CHANGEME","clearance":"restricted","role":"reader"},"carol":{"password":"CHANGEME","clearance":"public","role":"reader"},"dave":{"password":"CHANGEME","clearance":"internal","role":"uploader"},"erin":{"password":"CHANGEME","clearance":"internal","role":"approver"}}'
DEMO_USERS=

# Generation provider: "ollama" (default, local) or "groq" (hosted).
#
# ollama — no API key. Generation and embedding both run on this machine, so
#   document text never leaves it. This is the configuration the threat model
#   assumes and the one phase 2/3 results should be produced under.
# groq — free tier and much faster, but every question and every retrieved
#   chunk is sent to Groq. Restricted-tier text would leave the machine and the
#   corpus becomes subject to a third party's retention policy. Opt-in only.
#
# Embeddings are local either way — Chroma's embedder never crosses the network.
LLM_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# Optional: the content digest OLLAMA_MODEL must resolve to. Unset (default) =
# the digest is only recorded at startup, for change detection. Set it and the
# app refuses to boot on a mismatch OR when the digest cannot be resolved at all
# — "cannot tell" and "wrong" are the same state. Read the current value from
# `curl localhost:11434/api/tags` (the "digest" field for your model).
OLLAMA_MODEL_DIGEST=
# How often the pin is re-checked while running. Startup-only verification would
# miss a tag that moves afterwards until the next restart. Only read when a pin
# is set; a mismatch refuses the query the same way an unreachable model does.
OLLAMA_PIN_RECHECK_SECONDS=60
# Ollama defaults this to 2048, which silently truncates retrieved documents
# out of the prompt. Lower it only if you hit memory pressure.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=180

# Only read when LLM_PROVIDER=groq; required at startup in that case.
# Key from console.groq.com/keys. Check console.groq.com/docs/models for the
# current model list — Groq retires model IDs fairly often.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Agentic RAG: let the model invoke a `retrieve(query)` tool on demand instead
# of the fixed pre-retrieval step (this is where query rewriting happens for
# free). Needs a tool-calling model: Groq's 70B and the local llama3.2:3b both
# work (3b verified against this system prompt). The tier is still bound
# server-side, never a tool argument.
AGENTIC_RAG=false
AGENT_MAX_TOOL_ITERS=4
# Executed retrievals per request. Rounds and calls are different bounds — one
# round can carry many tool calls — and this is the one that caps provider cost,
# vector-store load, and how much chunk text a single request pulls into context.
AGENT_MAX_TOOL_CALLS=6
# Cheap first pass: minimum similarity between the query the MODEL chose and what
# the USER asked, before the retrieval runs. Bypassable by padding the query with
# the user's own wording, so it saves a wasted search rather than holding a line.
AGENT_MIN_QUERY_RELEVANCE=0.35
# Minimum similarity between a RETRIEVED PASSAGE and what the user asked. Applied
# to results, so padding the QUERY does not carry an unrelated document past it.
# Raise to tighten; lower if legitimate passages in unusual vocabulary get
# dropped. Bounds which EXISTING documents the agent can be steered into fetching; does not bound
# what a PLANTED document says (an uploader picks their own wording). Both are
# secure mode only, and both are tunable heuristics — watch the `relevance` numbers
# in audit.log before changing them.
AGENT_MIN_CHUNK_RELEVANCE=0.30

# Upstream source system the connector ingests from (mocksource).
# Tier is inherited from each record's ACL, not chosen by this app.
SOURCE_URL=http://localhost:8001
CONNECTOR_TIMEOUT=15
# Background sync interval in seconds. 0 disables the loop (manual /ingest only).
CONNECTOR_SYNC_SECONDS=60

# Resource limits (OWASP LLM10, Unbounded Consumption). Gated on
# SECURITY_FILTERS_ENABLED like every other defense, so phase 2 and phase 3 runs
# stay comparable — with filters off, none of these bound anything.
#
# Per-caller-per-window request budget. The caller is the account named by a
# signature-verified bearer token, or the peer address when there is no valid
# token (so /login is metered per address). Not the token itself — tokens carry
# an `exp` claim, so keying on one would let a caller buy a fresh allowance by
# logging in again. See redteam/findings/model-denial-of-service.md, UC-01.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# /query and /chat share this tighter budget: each one is an LLM generation.
RATE_LIMIT_GENERATE=10
# Generations allowed to run at once. A rate limit bounds requests per window,
# not how many models are resident simultaneously — this is the one that keeps a
# laptop from swapping. Past it a caller waits GENERATION_WAIT_SECONDS, then 503.
MAX_CONCURRENT_GENERATIONS=2
GENERATION_WAIT_SECONDS=5
# Request body ceiling, applied from Content-Length before the body is buffered.
# Must stay above the 2 MB document cap in app/ingest.py plus JSON escaping.
MAX_BODY_BYTES=4194304
# Output tokens per generation. Unset upstream this is unlimited on Ollama and
# billed per token on Groq, and nothing in the prompt stops "repeat forever".
MAX_OUTPUT_TOKENS=1024

# Retrieval tuning
TOP_K=4
MAX_DISTANCE=0.75
CHUNK_CHARS=1000
CHUNK_OVERLAP=150

# App
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./audit.log

# Grafana admin password (observability stack)
GRAFANA_ADMIN_PASSWORD=

# Answer-side entailment gate. The figure check (always on in secure mode) tests
# whether quantities in the answer occur in the retrieved text; it cannot see a
# claim that negates the evidence, attaches a real number to the wrong subject,
# or fabricates prose carrying no quantity at all. This runs a second, local
# model pass that judges each sentence against the passages and refuses the
# answer if any is unsupported.
#
# Off by default because it costs a second model round trip per answer (~0.4s on
# llama3.2:3b, more on a 12B) — a latency decision, not a security one. Phase-3
# runs that claim entailment coverage must set it true.
ANSWER_ENTAILMENT=false
