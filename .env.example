# Copy to .env and fill in. Never commit .env.

# Anthropic API — required, app refuses to start without it
ANTHROPIC_API_KEY=

# Auth — required. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SIGNING_KEY=
SESSION_TTL_SECONDS=3600

# Synthetic demo users, JSON. No default user table ships with the app —
# absent DEMO_USERS means every login fails, which is the safe direction.
# {"alice":{"password":"...","clearance":"restricted"},
#  "bob":{"password":"...","clearance":"internal"},
#  "carol":{"password":"...","clearance":"public"}}
DEMO_USERS=

# Retrieval tuning
TOP_K=4
MAX_DISTANCE=0.75
CHUNK_CHARS=1000
CHUNK_OVERLAP=150

# App
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./audit.log
